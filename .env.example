# Plantilla de variables. Copia este archivo a .env (uso local) y pon los mismos nombres en
# Render > Environment (backend) y en Streamlit Cloud > Settings > Secrets (solo QMC_API_URL).
# Los archivos reales no se suben: están en .gitignore. Nunca pongas claves en el código.

# --- Modelo: Claude Haiku por la API de Anthropic (console.anthropic.com > API keys) ---
ANTHROPIC_API_KEY=
# QMC_PROVEEDOR=claude                 # claude (por defecto), groq, gemini o grabado
# QMC_MODELO=claude-haiku-5-5
# QMC_ESFUERZO_RESPUESTA=low           # low (medido: mismos veredictos, la mitad de espera) o medium
# QMC_PRECIO_ENTRADA_USD_MTOK=0.10     # para calcular el gasto; cámbialo si Anthropic cambia el precio
# QMC_PRECIO_SALIDA_USD_MTOK=0.50

# --- Embeddings: Voyage AI (dashboard.voyageai.com > API keys). Sin clave se busca con BM25 ---
VOYAGE_API_KEY=
# QMC_MODELO_EMBEDDINGS=voyage-4-large
# QMC_RECUPERACION=emb_pregunta        # emb_pregunta (por defecto), bm25_variantes, emb_variantes o hibrido_variantes
# QMC_NORMALIZAR=0                     # 1 para normalizar la pregunta también cuando se busca con embeddings
# QMC_VOYAGE_PACIENTE=0                # 1 solo en scripts: lotes con pausas para una cuenta de Voyage sin medio de pago

# --- Observabilidad: Langfuse (cloud.langfuse.com > Settings > API keys). Sin claves no se envía nada ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# QMC_LANGFUSE_PREGUNTA=1              # 0 para no enviar el texto de la pregunta

# --- Topes de gasto ---
QMC_LIMITE_DISPOSITIVO_DIA=10
QMC_LIMITE_IP_DIA=60
QMC_LIMITE_SUBIDAS_DIA=10
QMC_TOPE_GLOBAL_USD=2.00
# Dónde viven los contadores. Vacío: SQLite en data/privado/ (solo sirve en local).
# En producción, la cadena de conexión de Postgres (Neon): postgresql://usuario:clave@host/base?sslmode=require
DATABASE_URL=

# --- Pólizas subidas (en memoria del servidor) ---
# QMC_TTL_POLIZA_MIN=60
# QMC_MAX_POLIZAS_EN_MEMORIA=20

# --- Streamlit: dónde está la API ---
QMC_API_URL=http://localhost:8000

# --- Proveedores alternativos (no hacen falta) ---
GROQ_API_KEY=
GEMINI_API_KEY=
