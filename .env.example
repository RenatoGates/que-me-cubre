# Plantilla de variables. Copia este archivo a .env (uso local) o pon los mismos valores
# en .streamlit/secrets.toml (app local) o en Settings > Secrets (Streamlit Community Cloud).
# Los archivos reales no se suben: están en .gitignore. Nunca pongas claves en el código.

# Proveedor del LLM: groq (por defecto) o gemini
QMC_PROVEEDOR=groq

# Groq, plan gratuito. Activa Zero Data Retention en console.groq.com > Data Controls.
GROQ_API_KEY=

# Solo si eliges gemini (alternativa manual). En su plan gratuito Google puede usar lo
# enviado para mejorar sus productos y personas pueden revisarlo: la app lo advierte.
GEMINI_API_KEY=

# Opcional: cambiar el modelo del proveedor elegido
# QMC_MODELO=openai/gpt-oss-120b
# QMC_MODELO_NORMALIZACION=openai/gpt-oss-120b
